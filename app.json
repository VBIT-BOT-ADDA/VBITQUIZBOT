{
  "name": "Telegram Quiz Bot",
  "description": "Quiz creation and broadcast bot powered by MongoDB and python-telegram-bot",
  "repository": "https://github.com/VBIT-BOT-ADDA/VBITQUIZBOT",
  "logo": "https://images.unsplash.com/photo-1606326608606-aa0b62935f2b?w=800",
  "keywords": [
    "telegram",
    "bot",
    "quiz",
    "mongodb",
    "python"
  ],
  "env": {
    "BOT_TOKEN": {
      "description": "Your Telegram Bot Token from @BotFather",
      "required": true
    },
    "MONGO_URI": {
      "description": "Your MongoDB Connection String (mongodb+srv://...)",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram Numeric User ID for Admin/Broadcast access",
      "required": true
    },
    "FORCE_SUB_CHANNEL": {
      "description": "Required channel username or channel ID. Example: @YourChannel or -1001234567890",
      "required": true
    },
    "FORCE_SUB_CHANNEL_LINK": {
      "description": "Channel invite/public link. Example: https://t.me/YourChannel",
      "required": true
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
